<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>New hiring request</title>
  </head>
  <body>
    <h2>Hello {{farmerName}},</h2>
    <p>{{landownerName}} has sent you a hiring request on CashiConnect.</p>
    <table cellpadding='6'>
      <tr><td><b>Job</b></td><td>{{jobTitle}}</td></tr>
      <tr><td><b>Land</b></td><td>{{landName}} ({{location}})</td></tr>
      <tr><td><b>Proposed salary</b></td><td>BDT {{salary}}</td></tr>
    </table>
    <p>Log in to CashiConnect to accept or reject this request.</p>
  </body>
</html>